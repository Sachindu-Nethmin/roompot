# MongoDB (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/roompot

# Long random string used to sign login sessions
SESSION_SECRET=change-me-to-a-long-random-string

# Open-weight model
# Local (default): Ollama running Gemma
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:E4B

# Hosted alternative: any OpenAI-compatible endpoint serving an open model, e.g. Gemma on Google AI Studio
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemma-3-27b-it
# LLM_API_KEY=your-key

# Optional
# MAX_ROOM_MEMBERS=8
