# MongoDB (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/roompot

# Long random string used to sign login sessions
SESSION_SECRET=change-me-to-a-long-random-string

# Open-weight model
# Browser: every phone runs Gemma 2 2B itself with WebLLM. No AI server or API key needed (best for public hosting).
# LLM_PROVIDER=browser

# Local (default): Ollama running Gemma
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:E4B

# Hosted (recommended for public use): any OpenAI-compatible endpoint serving an open model,
# e.g. Gemma 4 on Google AI Studio (free key at aistudio.google.com). People can still opt into
# private mode, which runs Gemma 2 2B in their own browser instead.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemma-4-26b-a4b-it
# LLM_API_KEY=your-key

# Optional
# MAX_ROOM_MEMBERS=8
# CHAT_LIMIT_PER_HOUR=60
